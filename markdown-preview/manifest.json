{
  "manifest_version": 3,
  "name": "墨览 · MarkView",
  "version": "1.2.0",
  "description": "本地 Markdown 阅读、文件树与可折叠章节目录",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "墨览 · MarkView",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["file:///*"],
    "include_globs": ["file:///*.md", "file:///*.md#*", "file:///*.markdown", "file:///*.markdown#*", "file:///*.MD", "file:///*.MD#*", "file:///*.mdown", "file:///*.mdown#*"],
    "js": ["markdown.js", "settings.js", "viewer.js"],
    "css": ["themes.css", "viewer.css"],
    "run_at": "document_idle"
  }]
}
